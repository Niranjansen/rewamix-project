NODE_ENV=development
PORT=5000

# MongoDB Atlas (or local) connection string - include the database name
MONGO_URI=mongodb://127.0.0.1:27017/rewamix_store

# Long random string (e.g. run: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_SECRET=change_this_secret

# Allowed frontends (comma separated). Leave empty in local dev = allow all.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# First admin account - created automatically on server start if missing
ADMIN_EMAIL=admin@rewamix.com
ADMIN_PASSWORD=change_this_password
ADMIN_NAME=Admin
